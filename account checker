import sys
import bcrypt
import mysql.connector

cnx = mysql.connector.connect(
    host="localhost",
    user="root",
    password="0000",
    database="database_name",
    autocommit=False,
)
cur = cnx.cursor()

def clean_exit():
    print('\nGoodbye')
    sys.exit()
def user_exit(user_input):
    if user_input.strip().lower() in ('quit', 'exit'):
        clean_exit()

def get_valid_name(login_type):
    if login_type == '2':
        prompt = 'Create username: '
    else:
        prompt = 'Username: '
    while True:
        username_input = input(prompt).strip()
        if username_input is None or username_input == "":
            prompt = "Username cannot be empty: "
            continue
        if not all(char.isalnum() or char == "_" or char == '-' for char in username_input):
            prompt = "Username contains invalid characters: "
            continue
        if not username_input[0].isalnum() or not username_input[-1].isalnum():
            prompt = "Username cannot contain trailing non-alphanumeric characters: "
            continue
        if len(username_input) < 1 or len(username_input) > 20:
            prompt = "Username must be between 1 and 20 characters: "
            continue
        if input(f'"{username_input}", is that right? (Y/N): ').strip().lower() not in ('y', 'yes'):
            prompt = "Please enter another username: "
            continue
        return username_input
def get_valid_pass(login_type):
    if login_type == '2':
        prompt = 'Create password: '
    else:
        prompt = 'Password: '
    while True:
        password_input = input(prompt)
        if password_input is None or password_input.strip() == "":
            prompt = "Password cannot be empty: "
            continue
        if not all(char.isalnum() or char.isspace() or char == "_" or char == '-' for char in password_input):
            prompt = "Password contains invalid characters: "
            continue
        if not password_input[0].isalnum() or not password_input[-1].isalnum():
            prompt = "Password cannot contain trailing non-alphanumeric characters: "
            continue
        """
        if len(password_input) < 8:
            prompt = "Password must contain at least 8 characters: "
            continue
        if len(password_input) > 30:
            prompt = "Password cannot contain more than 30 characters: "
            continue
        """
        if login_type == '2':
            password_confirmation = input('Please confirm password: ')
            if password_confirmation != password_input:
                prompt = "Password does not match. Please enter another password: "
                continue
        return password_input

def check_login(username, password_plain):
    cur.execute(
        "SELECT password FROM accounts WHERE username = %s",
        (username.strip(),)
    )
    row = cur.fetchone()
    if not row:
        return False
    stored_hash_str = row[0]
    return bcrypt.checkpw(
        password_plain.encode("utf-8"),
        stored_hash_str.encode("utf-8")
    )
def free_account_name(username):
    cur.execute(
        "SELECT 1 FROM accounts WHERE username = %s",
        (username.strip(),)
    )
    return cur.fetchone() is None
def register_account(username, password_plain):
    pw_hash = bcrypt.hashpw(password_plain.encode("utf-8"), bcrypt.gensalt())
    pw_hash_str = pw_hash.decode("utf-8")  # store as TEXT/VARCHAR
    try:
        cur.execute(
            "INSERT INTO accounts (username, password) VALUES (%s, %s)",
            (username.strip(), pw_hash_str)
        )
        cnx.commit()
    except mysql.connector.IntegrityError:
        cnx.rollback()
        raise

# MAIN SCRIPT

# Login Types
    # 1 = Login
    # 2 = Create Account
try:
    login_type = input('Login (1) or create account (2): ').strip()
    if login_type not in ('1', '2'):
        clean_exit()
    while True:
        username = get_valid_name(login_type)
        password = get_valid_pass(login_type)
        if login_type == '1':
            if check_login(username, password):
                print('Login successful.')
                break
            else:
                print('Incorrect username or password. Please try again.')
                continue

        else:
            if free_account_name(username):
                try:
                    register_account(username, password)
                except mysql.connector.IntegrityError:
                    print('Account already exists. Please try again.')
                    continue
                print('Account successfully created.')
                break
            else:
                print('Account already exists. Please try again.')
                continue
    clean_exit()
except KeyboardInterrupt:
    clean_exit()
except Exception:
    clean_exit()
finally:
    cur.close()
    cnx.close()
